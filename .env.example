# Database (MySQL / MariaDB)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=home_services
DB_USERNAME=root
DB_PASSWORD=
# Prisma reads DATABASE_URL; it is assembled from the DB_* values above.
# If the password has special characters (@ : / # ?), URL-encode them here.
DATABASE_URL="mysql://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_DATABASE}"

# Auth.js
AUTH_SECRET="generate-with: npx auth secret"
AUTH_URL="http://localhost:3000"

# App
APP_NAME="FixNear"
APP_CONTACT_EMAIL="info@fixnear.in"
APP_CONTACT_PHONE="+91-XXXX-XXXXXX"
APP_THEME_PRIMARY="#134E4A"
APP_THEME_ACCENT="#C4A052"
APP_THEME_SECONDARY="#1A2332"
APP_COMMISSION_DEFAULT=0.12
UPLOAD_DIR="./uploads"
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
FROM_EMAIL="noreply@fixnear.in"
# Leave SMTP_HOST empty in development: emails are written to .mail-outbox.log instead.

# Razorpay (optional). Leave empty to use the demo "Mark payment complete" button.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
